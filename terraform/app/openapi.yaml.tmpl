openapi: 3.0.2
info:
  title: Books API
  version: 1.0.0
servers:
  - url: ${backend_url}
paths:
  /health:
    get:
      x-google-backend:
        address: ${backend_url}/health
      responses:
        '200':
          description: Health check
  /api/books:
    get:
      security:
        - api_key: []
      x-google-backend:
        address: ${backend_url}/api/books
      responses:
        '200':
          description: List books
components:
  securitySchemes:
    api_key:
      type: apiKey
      name: X-API-KEY
      in: header

